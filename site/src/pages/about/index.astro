---
import Base from '../../layouts/Base.astro';
---
<Base page="about" title="About | Wizardlenz XR Studio" description="Meet the founders and the team behind Wizardlenz XR Studio, a Chennai studio building immersive worlds.">
<div class="view" id="v-about" data-view="about">
<section class="pg-hero" aria-labelledby="abH1">
  <div class="wrap">
    <p class="crumb"><a href="/" data-portal="Home">Home</a> / About</p>
    <h1 class="pg-h1" id="abH1" data-decode>A studio that builds immersive worlds, and the people who build them.</h1>
    <p class="lead">Wizardlenz XR Studio makes its own games and tools, builds XR for businesses, and teaches XR at colleges and universities. Each side makes the others better.</p>
  </div>
</section>
<section style="padding-top:24px" aria-label="Our founders">
  <div class="wrap">
    <div class="founder" style="margin-top:0">
      <div class="portrait"><img src="/img/nirmal-founder.webp" alt="Nirmal Jeyavelraj, Founder and Director of Wizardlenz XR Studio" width="800" height="800" loading="lazy"></div>
      <div>
        <p class="eyebrow">From the founder</p>
        <blockquote>"We are here not just to build products but to create possibilities."</blockquote>
        <p style="margin:22px 0 0;font-weight:700;font-size:18px">Nirmal Jeyavelraj</p>
        <p style="margin:2px 0 0;color:var(--mute)">Founder &amp; Director</p>
      </div>
    </div>

    <div class="founder rev">
      <div class="portrait"><img src="/img/reshik-ceo.webp" alt="Reshik Rabacca, Co-Founder and CEO of Wizardlenz XR Studio" width="800" height="800" loading="lazy"></div>
      <div>
        <p class="eyebrow">From the co-founder and CEO</p>
        <blockquote>"Driven by curiosity, unafraid of possibilities, and committed to building what the future deserves."</blockquote>
        <p style="margin:22px 0 0;font-weight:700;font-size:18px">Reshik Rabacca</p>
        <p style="margin:2px 0 0;color:var(--mute)">Co-Founder &amp; CEO</p>
      </div>
    </div>
  </div>
</section>
<section style="padding-top:0" aria-label="Numbers and recognition">
  <div class="wrap">
    <div class="counts">
      <div class="count"><b>1,200+</b><span>Students trained</span></div><div class="count"><b>25+</b><span>Workshops conducted</span></div><div class="count"><b>20+</b><span>Happy clients</span></div><div class="count"><b>70+</b><span>Prototypes developed</span></div>
    </div>
    <p class="chip-label" style="margin-top:36px">Recognised by</p>
    <div class="chips"><span class="chip">StartupTN</span><span class="chip">MSME</span><span class="chip">Startup India</span></div>
  </div>
</section>
<section style="padding-top:0" aria-labelledby="teamH">
  <div class="wrap">
    <p class="eyebrow">Team</p>
    <h2 class="h2" id="teamH" data-decode>The people behind the magic.</h2>
    <div class="team">
      <div class="member tilt" style="--c:#22D3EE"><div class="sig"><canvas data-sig="orb" data-c="#22D3EE" aria-hidden="true"></canvas><img class="ph" src="/img/nirmal-founder.webp" alt="Nirmal Jeyavelraj" width="420" height="420" loading="lazy"></div><span class="tag">The lens</span><b>Nirmal Jeyavelraj</b><span>Founder &amp; Director</span><span>XR &amp; Metaverse Expert</span></div>
      <div class="member tilt" style="--c:#A78BFA"><div class="sig"><canvas data-sig="neural" data-c="#A78BFA" aria-hidden="true"></canvas><img class="ph" src="/img/reshik-ceo.webp" alt="Reshik Rabacca" width="420" height="420" loading="lazy"></div><span class="tag">Neural network</span><b>Reshik Rabacca</b><span>Co-Founder &amp; CEO</span><span>AI/ML Expert</span></div>
      <div class="member tilt" style="--c:#F5B544"><div class="sig"><canvas data-sig="cube" data-c="#F5B544" aria-hidden="true"></canvas><img class="ph" src="/img/team/karthikeyan-l.webp" alt="Karthikeyan L" width="420" height="420" loading="lazy"></div><span class="tag">Spatial worlds</span><b>Karthikeyan L</b><span>XR Expert</span><span>Deakin University, Australia</span></div>
      <div class="member tilt" style="--c:#F0ABFC"><div class="sig"><canvas data-sig="mocap" data-c="#F0ABFC" aria-hidden="true"></canvas><img class="ph" src="/img/team/naveen-sayeprasad.webp" alt="Naveen Sayeprasad" width="420" height="420" loading="lazy"></div><span class="tag">Motion capture</span><b>Naveen Sayeprasad</b><span>Motion Capture Specialist</span><span>Coventry University, UK</span></div>
      <div class="member tilt" style="--c:#34D399"><div class="sig"><canvas data-sig="flow" data-c="#34D399" aria-hidden="true"></canvas><img class="ph" src="/img/team/ashwin-g.webp" alt="Ashwin G" width="420" height="420" loading="lazy"></div><span class="tag">Operations</span><b>Ashwin G</b><span>Business Operations Lead</span></div>
      <div class="member tilt" style="--c:#60A5FA"><div class="sig"><canvas data-sig="stack" data-c="#60A5FA" aria-hidden="true"></canvas><img class="ph" src="/img/team/karthik-k.webp" alt="Karthik K" width="420" height="420" loading="lazy"></div><span class="tag">Game development</span><b>Karthik K</b><span>Junior Game Developer</span></div>
    </div>
  </div>
</section>
<section style="padding-top:0" aria-label="Let's talk XR.">
  <div class="wrap"><div class="band"><div><h2 class="h2" style="margin:0">Let's talk XR.</h2><p class="lead" style="font-size:17px">A program for your institution, a project for your business, or a partnership.</p></div><a class="btn btn-primary mag" href="/contact/" data-portal="Contact">Start a conversation</a></div></div>
</section>
</div>
</Base>
