---
import '../styles/global.css';
import india from '../data/india-path.txt?raw';
const { page = 'home', title, description, noindex = false } = Astro.props;
const site = 'https://www.wizardlenzxrstudio.com';
const canonical = new URL(Astro.url.pathname, site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Wizardlenz XR Studio',
  legalName: 'Wizardlenz XR Studio (OPC) Pvt Ltd',
  url: site,
  logo: site + '/img/logo.png',
  slogan: 'See the magic! Be the magic!',
  email: 'inquiry@wizardlenzxrstudio.com',
  telephone: '+91 99629 04036',
  address: { '@type': 'PostalAddress', addressLocality: 'Chennai', addressRegion: 'Tamil Nadu', addressCountry: 'IN' },
  sameAs: ['https://www.linkedin.com/company/wizardlenz-xr-studio/', 'https://www.instagram.com/wizardlenz.xr_studio'],
};
---
<!doctype html>
<html lang="en" data-form-endpoint={import.meta.env.PUBLIC_FORM_ENDPOINT || undefined}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{noindex && <meta name="robots" content="noindex">}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Wizardlenz XR Studio">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={site + '/img/woxsen-2026.jpg'}>
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#08071A">
<link rel="icon" type="image/png" href="/img/emblem.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Manrope:wght@400;500;600;700&family=Unbounded:wght@500;700&display=swap">
{page === 'home' && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
</head>
<body data-page={page}>
<canvas id="bg" aria-hidden="true"></canvas>
<div class="vignette" aria-hidden="true"></div>
<div class="cursor" id="cursor" hidden></div>
<div id="portal" hidden aria-hidden="true"><div><img src="/img/logo.png" alt=""><p>Entering</p><strong id="portalTo">Academy</strong></div></div>
<script is:inline>
  try {
    var f = sessionStorage.getItem('wlz-portal');
    if (f !== null) {
      var p = document.getElementById('portal');
      document.getElementById('portalTo').textContent = f;
      p.hidden = false; p.style.clipPath = 'circle(150vmax at 50% 50%)';
    }
  } catch (e) {}
</script>
<header class="top">
  <div class="wrap">
    <a class="brand" href="/" data-portal="Home" aria-label="Wizardlenz XR Studio home"><img src="/img/logo.png" alt="" width="178" height="46"></a>
    <nav class="nav" id="mainNav" aria-label="Main">
      <a href="/academy/" data-portal="Academy" aria-current={page === 'academy' ? 'page' : undefined}>Academy</a>
      <a href="/studio/" data-portal="Studio" aria-current={page === 'studio' ? 'page' : undefined}>Studio</a>
      <a href="/originals/" data-portal="Originals" aria-current={page === 'originals' ? 'page' : undefined}>Originals</a>
      <a href="/gallery/" data-portal="Gallery" aria-current={page === 'gallery' ? 'page' : undefined}>Gallery</a>
      <a href="/about/" data-portal="About" aria-current={page === 'about' ? 'page' : undefined}>About</a>
    </nav>
    <div class="top-actions">
      <button type="button" class="menu-btn" id="menuBtn" aria-expanded="false" aria-controls="mainNav">Menu</button>
      <a class="btn btn-primary btn-sm mag" href="/contact/" data-portal="Contact">Let's talk</a>
    </div>
  </div>
</header>
<main id="main">
  <slot />
</main>
<footer>
  <div class="wrap">
    <img src="/img/logo.png" alt="Wizardlenz XR Studio" width="320" style="width:320px;max-width:100%;height:auto;display:block">
    <p class="sign">See The Magic! Be The Magic!</p>
    <div class="flinks">
      <div><b>Academy</b><a href="/academy/">For institutions</a><a href="/academy/">Topic modules</a><a href="/academy/">Internships</a><a href="/academy/">Certificate check</a></div>
      <div><b>Studio</b><a href="/studio/">XR for business</a><a href="/studio/">Immersive events</a></div>
      <div><b>Originals</b><a href="/originals/">Games</a><a href="https://immersitest.wizardlenzxrstudio.com/#/" target="_blank" rel="noopener noreferrer">ImmersiTest</a></div>
      <div><b>Company</b><a href="/gallery/">Gallery</a><a href="/about/">About</a><a href="/contact/">Contact</a></div>
      <div><b>Follow</b><a href="https://www.linkedin.com/company/wizardlenz-xr-studio/" target="_blank" rel="noopener noreferrer">LinkedIn</a><a href="https://www.instagram.com/wizardlenz.xr_studio" target="_blank" rel="noopener noreferrer">Instagram</a></div>
    </div>
    <div class="legal"><span>© 2026 Wizardlenz XR Studio (OPC) Pvt Ltd</span><span><a href="/terms/">Terms &amp; Conditions</a> · <a href="/privacy/">Privacy Policy</a> · <a href="/refund/">Cancellation and Refund Policy</a></span></div>
  </div>
</footer>
<script type="text/plain" id="indiaPath" set:html={india} />
<script is:inline src="/vendor/three.min.js"></script>
<script>
  import '../scripts/site.js';
  import { initChatbot } from '../scripts/chatbot.js';
  initChatbot();
</script>
</body>
</html>
